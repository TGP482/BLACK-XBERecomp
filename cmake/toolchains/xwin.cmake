# Linux -> Windows x64 using LLVM and an xwin splat (no Wine required).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_SYSTEM_VERSION 10.0)
# xwin's default splat includes the release CRT, including for compiler checks.
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL CACHE STRING "MSVC runtime")

set(XWIN_ROOT "$ENV{XWIN_ROOT}" CACHE PATH "Directory produced by xwin splat")
if(NOT EXISTS "${XWIN_ROOT}/crt/include" OR NOT EXISTS "${XWIN_ROOT}/sdk/include/um")
    message(FATAL_ERROR "Set XWIN_ROOT to the directory produced by xwin splat --output <directory>")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES XWIN_ROOT)
set(CMAKE_FIND_ROOT_PATH "${XWIN_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

find_program(CMAKE_C_COMPILER NAMES clang-cl REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES clang-cl REQUIRED)
find_program(CMAKE_LINKER NAMES lld-link REQUIRED)
find_program(CMAKE_AR NAMES llvm-lib REQUIRED)
find_program(CMAKE_RC_COMPILER NAMES llvm-rc REQUIRED)
find_program(CMAKE_MT NAMES llvm-mt REQUIRED)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)

set(_xwin_includes "")
foreach(_dir crt/include sdk/include/ucrt sdk/include/shared sdk/include/um sdk/include/winrt)
    string(APPEND _xwin_includes " /imsvc\"${XWIN_ROOT}/${_dir}\"")
endforeach()
set(CMAKE_C_FLAGS_INIT "/clang:-march=x86-64-v2 ${_xwin_includes}")
set(CMAKE_CXX_FLAGS_INIT "/clang:-march=x86-64-v2 ${_xwin_includes}")
set(CMAKE_RC_FLAGS_INIT "-I\"${XWIN_ROOT}/crt/include\" -I\"${XWIN_ROOT}/sdk/include/ucrt\" -I\"${XWIN_ROOT}/sdk/include/shared\" -I\"${XWIN_ROOT}/sdk/include/um\"")
set(_xwin_libs "/libpath:\"${XWIN_ROOT}/crt/lib/x86_64\" /libpath:\"${XWIN_ROOT}/sdk/lib/ucrt/x86_64\" /libpath:\"${XWIN_ROOT}/sdk/lib/um/x86_64\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_xwin_libs}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_xwin_libs}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_xwin_libs}")
