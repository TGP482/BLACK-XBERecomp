+#pragma once
+// The Vulkan device the renderer draws with: instance, the GPU and its queue, memory through VMA, images, buffers
+// and the timeline that stands in for the D3D12 fence. Nothing here knows the title.
+#include <vulkan/vulkan.h>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+struct VmaAllocator_T;
+struct VmaAllocation_T;
+
+namespace gpu::vk {
+
+class Context;
+
+struct ImageDesc {
+    VkFormat format = VK_FORMAT_B8G8R8A8_UNORM;
+    uint32_t w = 1, h = 1, depth = 1;  // depth > 1: a 3D image
+    uint32_t layers = 1;               // 6 with cube
+    uint32_t levels = 1;
+    uint32_t samples = 1;
+    bool cube = false;
+    bool target = false;  // a colour or depth attachment
+    bool depth_stencil = false;
+};
+
+// one image with its views; the layout is tracked here as D3D12 tracked resource states
+struct Image {
+    Context* ctx = nullptr;
+    VkImage image = VK_NULL_HANDLE;
+    VmaAllocation_T* alloc = nullptr;
+    ImageDesc desc;
+    VkImageAspectFlags aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    VkImageView view = VK_NULL_HANDLE;    // sampled: every level and layer; a depth image's depth alone
+    VkImageView target = VK_NULL_HANDLE;  // attachment: level 0, depth and stencil together
+    VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    ~Image();
+};
+using ImageRef = std::shared_ptr<Image>;
+
+enum class Memory : uint8_t { Device, Upload, Readback };
+
+struct Buffer {
+    Context* ctx = nullptr;
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VmaAllocation_T* alloc = nullptr;
+    uint8_t* map = nullptr;  // host visible ones stay mapped
+    VkDeviceSize size = 0;
+    ~Buffer();
+    void Invalidate();  // a read-back buffer before the CPU reads what the GPU wrote
+};
+using BufferRef = std::shared_ptr<Buffer>;
+
+struct Caps {
+    // the device a saved pipeline cache has to belong to: the header names vendor, device and driver UUID
+    uint32_t vendor_id = 0, device_id = 0;
+    uint8_t cache_uuid[VK_UUID_SIZE] = {};
+    VkFormat depth_format = VK_FORMAT_D24_UNORM_S8_UINT;  // else D32_SFLOAT_S8_UINT
+    bool custom_border = false;   // VK_EXT_custom_border_color
+    bool hdr_metadata = false;    // VK_EXT_hdr_metadata
+    bool colorspace = false;      // VK_EXT_swapchain_colorspace
+    bool queries = false;         // precise occlusion queries, reset from the host
+    bool geometry = false;        // geometry shaders (points drawn as quads)
+    // Vulkan 1.3 has these in core; a 1.1 or 1.2 device (Adreno 6xx, most Android) offers them as
+    // extensions. rendering scopes are the one that a device may simply not have at all, and the
+    // renderer then draws through render passes instead.
+    bool dynamic_rendering = false;       // core 1.3 rendering scopes, else the render pass fallback
+    bool sync2 = false;                   // vkCmdPipelineBarrier2 / vkQueueSubmit2
+    bool timeline = false;                // timeline semaphores
+    bool host_query_reset = false;        // vkResetQueryPool
+    bool scalar_layout = false;           // VK_EXT_scalar_block_layout
+    bool extended_dynamic_state = false;  // dynamic primitive topology and vertex binding stride
+    float max_anisotropy = 1;
+    VkSampleCountFlags color_samples = VK_SAMPLE_COUNT_1_BIT, depth_samples = VK_SAMPLE_COUNT_1_BIT;
+    std::string device_name;
+};
+
+// entry points that only exist as KHR/EXT below the version that promoted them: Android's loader
+// exports the core names alone and its drivers answer only the extension ones, so ask for both
+struct Dispatch {
+    PFN_vkCmdPipelineBarrier2 PipelineBarrier2 = nullptr;
+    PFN_vkQueueSubmit2 QueueSubmit2 = nullptr;
+    PFN_vkGetSemaphoreCounterValue GetSemaphoreCounterValue = nullptr;
+    PFN_vkWaitSemaphores WaitSemaphores = nullptr;
+    PFN_vkResetQueryPool ResetQueryPool = nullptr;
+    PFN_vkCmdBindVertexBuffers2 BindVertexBuffers2 = nullptr;
+    PFN_vkCmdSetPrimitiveTopology SetPrimitiveTopology = nullptr;
+    // rendering scopes: not a required entry point (a 1.1 device has no dynamic rendering), so resolved but not checked
+    PFN_vkCmdBeginRendering CmdBeginRendering = nullptr;
+    PFN_vkCmdEndRendering CmdEndRendering = nullptr;
+};
+
+class Context {
+public:
+    ~Context();
+    // instance_extensions: what the window system's surface needs (SDL_Vulkan_GetInstanceExtensions), none headless;
+    // XBE_VK_VALIDATION in the environment turns the Khronos validation layer on when it is installed
+    bool Init(const char* const* instance_extensions, uint32_t count, bool want_swapchain);
+
+    VkInstance instance = VK_NULL_HANDLE;
+    VkPhysicalDevice phys = VK_NULL_HANDLE;
+    VkDevice dev = VK_NULL_HANDLE;
+    VkQueue queue = VK_NULL_HANDLE;
+    uint32_t family = 0;
+    uint32_t device_api = VK_API_VERSION_1_0;  // the version the device is used at
+    VmaAllocator_T* vma = nullptr;
+    Caps caps;
+    Dispatch d;
+
+    ImageRef CreateImage(const ImageDesc& d);
+    BufferRef CreateBuffer(VkDeviceSize size, VkBufferUsageFlags usage, Memory mem);
+
+    // the timeline semaphore: values signalled by submits, as the D3D12 fence's
+    VkSemaphore timeline = VK_NULL_HANDLE;
+    uint64_t Completed() const;
+    void Wait(uint64_t value) const;
+
+private:
+    VkDebugUtilsMessengerEXT messenger_ = VK_NULL_HANDLE;
+    uint32_t api_ = VK_API_VERSION_1_3, device_api_ = VK_API_VERSION_1_3;
+    bool PickDevice(bool want_swapchain);
+    bool CreateDevice(bool want_swapchain);
+};
+
+// the image's whole layout changed: the old layout's writes done and visible to the new layout's uses, its reads done
+// before the new layout's writes; the copy destination layout is entered again with a barrier, so copies stay in order
+void Transition(Context& ctx, VkCommandBuffer cb, Image& img, VkImageLayout to);
+// a new rendering scope after another: attachment writes before it done and visible to its loads and writes
+void AttachmentDependency(Context& ctx, VkCommandBuffer cb);
+// the image at level 0 / layer 0 as a copy's subresource
+VkImageSubresourceLayers Layers(const Image& img, uint32_t level = 0, uint32_t layer = 0);
+
+}  // namespace gpu::vk
diff --git a/sdk/runtime/gpu/vk_formats.cpp b/sdk/runtime/gpu/vk_formats.cpp
new file mode 100644
index 0000000..871553c
--- /dev/null
+++ b/sdk/runtime/gpu/vk_formats.cpp
@@ -0,0 +1,206 @@
+#include "gpu/vk_formats.h"
+
+#include <dxgiformat.h>
+
+#include <algorithm>
+#include <cstring>
+
+namespace gpu::vk {
+
+namespace {
+
+float Bits(uint32_t v) {
+    float f;
+    std::memcpy(&f, &v, 4);
+    return f;
+}
+
+// D3DTEXF: 1 point, 2 linear, 3 anisotropic
+constexpr uint32_t kTexfLinear = 2;
+constexpr uint32_t kTexfAnisotropic = 3;
+constexpr uint32_t kTaddressWrap = 1;
+constexpr uint32_t kTaddressClamp = 3;
+
+// D3DCMP_NEVER..ALWAYS in order, the D3D12 numbering minus one
+constexpr VkCompareOp kCompare[8] = {VK_COMPARE_OP_NEVER,         VK_COMPARE_OP_LESS,
+                                     VK_COMPARE_OP_EQUAL,         VK_COMPARE_OP_LESS_OR_EQUAL,
+                                     VK_COMPARE_OP_GREATER,       VK_COMPARE_OP_NOT_EQUAL,
+                                     VK_COMPARE_OP_GREATER_OR_EQUAL, VK_COMPARE_OP_ALWAYS};
+
+uint32_t CompareIndex(uint32_t d3d) { return d3d >= 0x200 && d3d <= 0x207 ? d3d - 0x200 : 7; }
+
+}  // namespace
+
+VkBlendFactor Blend(uint32_t v, bool alpha) {
+    switch (v) {
+        case 0: return VK_BLEND_FACTOR_ZERO;
+        case 1: return VK_BLEND_FACTOR_ONE;
+        case 0x300: return alpha ? VK_BLEND_FACTOR_SRC_ALPHA : VK_BLEND_FACTOR_SRC_COLOR;
+        case 0x301: return alpha ? VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA : VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR;
+        case 0x302: return VK_BLEND_FACTOR_SRC_ALPHA;
+        case 0x303: return VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+        case 0x304: return VK_BLEND_FACTOR_DST_ALPHA;
+        case 0x305: return VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA;
+        case 0x306: return alpha ? VK_BLEND_FACTOR_DST_ALPHA : VK_BLEND_FACTOR_DST_COLOR;
+        case 0x307: return alpha ? VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA : VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR;
+        case 0x308: return alpha ? VK_BLEND_FACTOR_ONE : VK_BLEND_FACTOR_SRC_ALPHA_SATURATE;
+        // the blend colour, and its alpha; D3D12 had no constant alpha factor, Vulkan does
+        case 0x8001: return alpha ? VK_BLEND_FACTOR_CONSTANT_ALPHA : VK_BLEND_FACTOR_CONSTANT_COLOR;
+        case 0x8002: return alpha ? VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA : VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR;
+        case 0x8003: return VK_BLEND_FACTOR_CONSTANT_ALPHA;
+        case 0x8004: return VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA;
+        default: return VK_BLEND_FACTOR_ONE;
+    }
+}
+
+VkBlendOp BlendOp(uint32_t v) {
+    switch (v) {
+        case 0x800A: return VK_BLEND_OP_SUBTRACT;
+        case 0x800B: return VK_BLEND_OP_REVERSE_SUBTRACT;
+        case 0x8007: return VK_BLEND_OP_MIN;
+        case 0x8008: return VK_BLEND_OP_MAX;
+        default: return VK_BLEND_OP_ADD;
+    }
+}
+
+VkCompareOp Compare(uint32_t v) { return kCompare[CompareIndex(v)]; }
+
+VkCompareOp ShadowCompare(uint32_t v) {
+    // texel OP r read as r OP' texel: less and greater trade places, equality stays
+    static const uint8_t swap[8] = {0, 4, 2, 6, 1, 5, 3, 7};
+    return kCompare[swap[CompareIndex(v)]];
+}
+
+VkStencilOp StencilOp(uint32_t v) {
+    switch (v) {
+        case 0: return VK_STENCIL_OP_ZERO;
+        case 0x1E01: return VK_STENCIL_OP_REPLACE;
+        case 0x1E02: return VK_STENCIL_OP_INCREMENT_AND_CLAMP;
+        case 0x1E03: return VK_STENCIL_OP_DECREMENT_AND_CLAMP;
+        case 0x150A: return VK_STENCIL_OP_INVERT;
+        case 0x8507: return VK_STENCIL_OP_INCREMENT_AND_WRAP;
+        case 0x8508: return VK_STENCIL_OP_DECREMENT_AND_WRAP;
+        default: return VK_STENCIL_OP_KEEP;
+    }
+}
+
+VkSamplerAddressMode Address(uint32_t v) {
+    switch (v) {
+        case 2: return VK_SAMPLER_ADDRESS_MODE_MIRRORED_REPEAT;
+        case 3: case 5: return VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+        case 4: return VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER;
+        default: return VK_SAMPLER_ADDRESS_MODE_REPEAT;
+    }
+}
+
+VkColorComponentFlags ColorWriteMask(uint32_t cw) {
+    VkColorComponentFlags m = 0;
+    if ((cw >> 16) & 1) m |= VK_COLOR_COMPONENT_R_BIT;
+    if ((cw >> 8) & 1) m |= VK_COLOR_COMPONENT_G_BIT;
+    if (cw & 1) m |= VK_COLOR_COMPONENT_B_BIT;
+    if ((cw >> 24) & 1) m |= VK_COLOR_COMPONENT_A_BIT;
+    return m;
+}
+
+VkFormat VertexFormat(uint32_t dxgi) {
+    switch (dxgi) {
+        case DXGI_FORMAT_R32G32B32A32_FLOAT: return VK_FORMAT_R32G32B32A32_SFLOAT;
+        case DXGI_FORMAT_R32G32B32_FLOAT: return VK_FORMAT_R32G32B32_SFLOAT;
+        case DXGI_FORMAT_R16G16B16A16_SNORM: return VK_FORMAT_R16G16B16A16_SNORM;
+        case DXGI_FORMAT_R16G16B16A16_SINT: return VK_FORMAT_R16G16B16A16_SINT;
+        case DXGI_FORMAT_R32G32_FLOAT: return VK_FORMAT_R32G32_SFLOAT;
+        case DXGI_FORMAT_R8G8B8A8_UNORM: return VK_FORMAT_R8G8B8A8_UNORM;
+        case DXGI_FORMAT_R16G16_SNORM: return VK_FORMAT_R16G16_SNORM;
+        case DXGI_FORMAT_R16G16_SINT: return VK_FORMAT_R16G16_SINT;
+        case DXGI_FORMAT_R32_FLOAT: return VK_FORMAT_R32_SFLOAT;
+        case DXGI_FORMAT_R32_UINT: return VK_FORMAT_R32_UINT;
+        case DXGI_FORMAT_R8G8_UNORM: return VK_FORMAT_R8G8_UNORM;
+        case DXGI_FORMAT_R16_SNORM: return VK_FORMAT_R16_SNORM;
+        case DXGI_FORMAT_R16_SINT: return VK_FORMAT_R16_SINT;
+        case DXGI_FORMAT_R8_UNORM: return VK_FORMAT_R8_UNORM;
+        case DXGI_FORMAT_B8G8R8A8_UNORM: return VK_FORMAT_B8G8R8A8_UNORM;
+        default: return VK_FORMAT_UNDEFINED;
+    }
+}
+
+VkFormat HostFormat(Host h) {
+    switch (h) {
+        case Host::BC1: return VK_FORMAT_BC1_RGBA_UNORM_BLOCK;
+        case Host::BC2: return VK_FORMAT_BC2_UNORM_BLOCK;
+        case Host::BC3: return VK_FORMAT_BC3_UNORM_BLOCK;
+        case Host::R32F: return VK_FORMAT_R32_SFLOAT;
+        default: return VK_FORMAT_B8G8R8A8_UNORM;
+    }
+}
+
+bool IsBlockCompressed(VkFormat f) {
+    return f == VK_FORMAT_BC1_RGBA_UNORM_BLOCK || f == VK_FORMAT_BC2_UNORM_BLOCK || f == VK_FORMAT_BC3_UNORM_BLOCK;
+}
+
+uint32_t FormatBytes(VkFormat f) {
+    switch (f) {
+        case VK_FORMAT_R8_UNORM: return 1;
+        case VK_FORMAT_R8G8_UNORM: return 2;
+        case VK_FORMAT_BC1_RGBA_UNORM_BLOCK:
+        case VK_FORMAT_R16G16B16A16_UNORM:
+        case VK_FORMAT_R16G16B16A16_SFLOAT: return 8;
+        case VK_FORMAT_BC2_UNORM_BLOCK:
+        case VK_FORMAT_BC3_UNORM_BLOCK: return 16;
+        default: return 4;
+    }
+}
+
+uint32_t RowBytes(VkFormat f, uint32_t width) {
+    return IsBlockCompressed(f) ? ((width + 3) / 4) * FormatBytes(f) : width * FormatBytes(f);
+}
+
+uint32_t RowCount(VkFormat f, uint32_t height) { return IsBlockCompressed(f) ? (height + 3) / 4 : height; }
+
+void Color(uint32_t argb, float* o) {
+    o[0] = ((argb >> 16) & 255) / 255.0f;
+    o[1] = ((argb >> 8) & 255) / 255.0f;
+    o[2] = (argb & 255) / 255.0f;
+    o[3] = (argb >> 24) / 255.0f;
+}
+
+SamplerDesc StageSampler(const State& s, int i, bool clamp, uint32_t aniso, bool mipped, bool shadow) {
+    SamplerDesc sd;
+    const auto& t = s.tss[size_t(i)];
+    uint32_t mag = t[kTssMagFilter];
+    uint32_t min = t[kTssMinFilter];
+    uint32_t mip = t[kTssMipFilter];
+    auto lin = [](uint32_t f) { return f >= kTexfLinear; };
+    sd.min = lin(min) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+    sd.mag = lin(mag) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+    sd.mip = mip == kTexfLinear ? VK_SAMPLER_MIPMAP_MODE_LINEAR : VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    bool anisotropic = min == kTexfAnisotropic || mag == kTexfAnisotropic;
+    uint32_t an = anisotropic ? std::max<uint32_t>(t[kTssMaxAnisotropy], 1) : 1;
+    // forced only where the title filters across mip levels and the texture has them
+    if (aniso && lin(min) && mip && mipped && !shadow) an = aniso;
+    if (an > 1) {
+        // Direct3D's anisotropic filter is linear in every direction
+        sd.min = sd.mag = VK_FILTER_LINEAR;
+        sd.mip = VK_SAMPLER_MIPMAP_MODE_LINEAR;
+        sd.anisotropy = std::min<uint32_t>(an, 16);
+    }
+    uint32_t u = t[kTssAddressU];
+    uint32_t v = t[kTssAddressV];
+    sd.u = Address(clamp && u == kTaddressWrap ? kTaddressClamp : u);
+    sd.v = Address(clamp && v == kTaddressWrap ? kTaddressClamp : v);
+    sd.w = Address(t[kTssAddressW]);
+    sd.lod_bias = Bits(t[kTssMipLodBias]);
+    sd.min_lod = float(t[kTssMaxMipLevel]);
+    sd.max_lod = mip ? VK_LOD_CLAMP_NONE : sd.min_lod;
+    Color(t[kTssBorderColor], sd.border);
+    if (shadow) {
+        sd.min = lin(min) || lin(mag) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+        sd.mag = sd.min;
+        sd.mip = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+        sd.anisotropy = 1;
+        sd.compare = 1;
+        sd.compare_op = ShadowCompare(s.rs[kRsShadowFunc]);
+    }
+    return sd;
+}
+
+}  // namespace gpu::vk
diff --git a/sdk/runtime/gpu/vk_formats.h b/sdk/runtime/gpu/vk_formats.h
new file mode 100644
index 0000000..d750da3
--- /dev/null
+++ b/sdk/runtime/gpu/vk_formats.h
@@ -0,0 +1,60 @@
+#pragma once
+// The title's Direct3D 8 state as Vulkan takes it: blend, compare, stencil and address modes, sampler filters,
+// vertex element and texture formats. Pure functions, no device.
+#include <vulkan/vulkan.h>
+
+#include <cstdint>
+
+#include "gpu/state.h"
+#include "gpu/texture.h"
+
+namespace gpu::vk {
+
+// D3DBLEND as a colour or an alpha factor
+VkBlendFactor Blend(uint32_t d3d, bool alpha);
+// D3DBLENDOP
+VkBlendOp BlendOp(uint32_t d3d);
+// D3DCMP_* (0x200 to 0x207), anything else always
+VkCompareOp Compare(uint32_t d3d);
+// the console tests texel OP reference for shadow lookups; Vulkan tests reference OP texel
+VkCompareOp ShadowCompare(uint32_t d3d);
+// D3DSTENCILOP
+VkStencilOp StencilOp(uint32_t d3d);
+// D3DTEXTUREADDRESS
+VkSamplerAddressMode Address(uint32_t d3d);
+// console ARGB colour write bits to Vulkan RGBA bits
+VkColorComponentFlags ColorWriteMask(uint32_t d3d);
+
+// a vertex element's DXGI format number (gpu/vertex.cpp names them) as Vulkan reads it
+VkFormat VertexFormat(uint32_t dxgi);
+
+// what a console texture format is uploaded as
+VkFormat HostFormat(Host h);
+// bytes per texel, or per 4x4 block of a compressed format
+uint32_t FormatBytes(VkFormat f);
+bool IsBlockCompressed(VkFormat f);
+// a row of texels, or of blocks, in bytes; the rows of a level (block rows when compressed)
+uint32_t RowBytes(VkFormat f, uint32_t width);
+uint32_t RowCount(VkFormat f, uint32_t height);
+
+// one stage's sampler as Direct3D 8 sets it; aniso the setting's forced level, 0 for the title's;
+// every field is 4 bytes, so a desc hashes as its bytes; clamp: the draw's coordinates all lie in 0..1, wrap is read as clamp; mipped: the texture has levels;
+// shadow: a depth texture compared against
+struct SamplerDesc {
+    VkFilter min = VK_FILTER_NEAREST, mag = VK_FILTER_NEAREST;
+    VkSamplerMipmapMode mip = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    VkSamplerAddressMode u = VK_SAMPLER_ADDRESS_MODE_REPEAT, v = VK_SAMPLER_ADDRESS_MODE_REPEAT,
+                         w = VK_SAMPLER_ADDRESS_MODE_REPEAT;
+    float lod_bias = 0, min_lod = 0, max_lod = VK_LOD_CLAMP_NONE;
+    uint32_t anisotropy = 1;  // 1 off
+    uint32_t compare = 0;  // 1: a comparison sampler
+    VkCompareOp compare_op = VK_COMPARE_OP_NEVER;
+    float border[4] = {};  // RGBA
+    bool operator==(const SamplerDesc&) const = default;
+};
+SamplerDesc StageSampler(const State& s, int stage, bool clamp, uint32_t aniso, bool mipped, bool shadow);
+
+// D3DCOLOR (ARGB) to RGBA floats
+void Color(uint32_t argb, float out[4]);
+
+}  // namespace gpu::vk
diff --git a/sdk/runtime/gpu/vk_shaders.cpp b/sdk/runtime/gpu/vk_shaders.cpp
new file mode 100644
index 0000000..6b3c08d
--- /dev/null
+++ b/sdk/runtime/gpu/vk_shaders.cpp
@@ -0,0 +1,98 @@
+#include "gpu/vk_shaders.h"
+
+#include <dlfcn.h>
+#include <unistd.h>
+
+#include <dxc/dxcapi.h>
+
+#include <climits>
+#include <filesystem>
+#include <mutex>
+
+namespace gpu::vk {
+
+namespace {
+
+// libdxcompiler.so beside the executable first, then wherever the system keeps it
+DxcCreateInstanceProc LoadDxc(std::string& error) {
+    static DxcCreateInstanceProc create = nullptr;
+    static std::string failed;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        char self[PATH_MAX] = {};
+        ssize_t n = readlink("/proc/self/exe", self, sizeof(self) - 1);
+        std::string beside = n > 0 ? (std::filesystem::path(std::string(self, size_t(n))).parent_path() / "libdxcompiler.so").string()
+                                   : std::string();
+        void* lib = beside.empty() ? nullptr : dlopen(beside.c_str(), RTLD_NOW | RTLD_LOCAL);
+        if (!lib) lib = dlopen("libdxcompiler.so", RTLD_NOW | RTLD_LOCAL);
+        if (!lib) {
+            failed = std::string("libdxcompiler.so not found: ") + dlerror();
+            return;
+        }
+        create = reinterpret_cast<DxcCreateInstanceProc>(dlsym(lib, "DxcCreateInstance"));
+        if (!create) failed = "libdxcompiler.so has no DxcCreateInstance";
+    });
+    if (!create) error = failed;
+    return create;
+}
+
+const wchar_t* Profile(Stage s) {
+    switch (s) {
+        case Stage::Vertex: return L"vs_6_0";
+        case Stage::Geometry: return L"gs_6_0";
+        default: return L"ps_6_0";
+    }
+}
+
+std::wstring Wide(const char* s) { return std::wstring(s, s + std::strlen(s)); }
+
+}  // namespace
+
+std::vector<uint32_t> CompileHlsl(const std::string& src, const char* entry, Stage stage, std::string& error) {
+    DxcCreateInstanceProc create = LoadDxc(error);
+    if (!create) return {};
+    // one compiler per thread: DXC's objects are not shared across threads
+    thread_local CComPtr<IDxcCompiler3> compiler;
+    if (!compiler && FAILED(create(CLSID_DxcCompiler, IID_PPV_ARGS(&compiler)))) {
+        error = "DxcCreateInstance failed";
+        return {};
+    }
+    std::wstring e = Wide(entry);
+    std::wstring b0 = std::to_wstring(kBindingConstants), t0 = std::to_wstring(kBindingTextures),
+                 s0 = std::to_wstring(kBindingSamplers);
+    // HLSL 2018: the generated code compares and selects whole vectors, which 2021 no longer allows
+    const wchar_t* args[] = {
+        L"-spirv", L"-HV", L"2018", L"-T", Profile(stage), L"-E", e.c_str(), L"-O3",
+        L"-fspv-target-env=vulkan1.3",
+        L"-fspv-entrypoint-name=main",  // every entry point is main in SPIR-V, whatever the HLSL calls it
+        L"-fvk-use-dx-layout",         // constant buffers packed as Direct3D packs them
+        L"-fvk-use-dx-position-w",     // a pixel shader's SV_Position.w is w, as Direct3D gives it
+        L"-fvk-b-shift", b0.c_str(), L"0", L"-fvk-t-shift", t0.c_str(), L"0", L"-fvk-s-shift", s0.c_str(), L"0",
+        L"-Wno-conversion", L"-Wno-parentheses-equality",
+    };
+    DxcBuffer buf{src.data(), src.size(), DXC_CP_UTF8};
+    CComPtr<IDxcResult> result;
+    if (FAILED(compiler->Compile(&buf, args, UINT32(std::size(args)), nullptr, IID_PPV_ARGS(&result)))) {
+        error = "IDxcCompiler3::Compile failed";
+        return {};
+    }
+    HRESULT status = E_FAIL;
+    result->GetStatus(&status);
+    CComPtr<IDxcBlobUtf8> messages;
+    result->GetOutput(DXC_OUT_ERRORS, IID_PPV_ARGS(&messages), nullptr);
+    if (FAILED(status)) {
+        error = messages && messages->GetStringLength() ? messages->GetStringPointer() : "compile failed";
+        return {};
+    }
+    CComPtr<IDxcBlob> code;
+    if (FAILED(result->GetOutput(DXC_OUT_OBJECT, IID_PPV_ARGS(&code), nullptr)) || !code) {
+        error = "no SPIR-V";
+        return {};
+    }
+    const auto* words = static_cast<const uint32_t*>(code->GetBufferPointer());
+    return std::vector<uint32_t>(words, words + code->GetBufferSize() / 4);
+}
+
+bool CompilerAvailable(std::string& error) { return LoadDxc(error) != nullptr; }
+
+}  // namespace gpu::vk
diff --git a/sdk/runtime/gpu/vk_shaders.h b/sdk/runtime/gpu/vk_shaders.h
